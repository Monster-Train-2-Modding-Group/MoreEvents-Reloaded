      "soul_savior_prefab": {
        "asset_name": "Assets/GameData/Story/Event Prefabs/SoulSavior/Event_SS_Background_DivineShards.prefab",
        "asset_guid": "9c1635d93174671438cf9c3020f62783"
      },
      "texts": [
        {
          "english": "<whisper>\"When the Divine Temples fell, their secrets did not vanish-they just scattered. This altar still remembers how to weave two souls into one, or forge raw divinity into a spell. The fire awaits\"</whisper></style>"
        },
        {
          "english": "One form dissolves into brilliant, liquid embers that flow steadily across the floor conduits, pouring directly into the heart of the survivor."
        },
        {
          "english": "The text flares blindingly, permanently rewritten by divine law."
        },
        {
          "english": "<style=\"Body\">You place the spell upon the altar. Brass needles snap forward, etching liquid gold directly onto the spell as ancient temple power floods the parchment."
        },
        {
          "english": "<style=\"Prompt\">Do you dare invoke its power?</style>"
        },
        {
          "english": "<whisper>\"A cautious soul,\"</whisper> the voice sighs, fading into the cold chamber. <whisper>\"The altar waits, as it always has.\"</whisper></style>"
        },
        {
          "english": "The remaining unit draws a sharp, resonant breath, its eyes now burning with a twin flame.</style>"
        },
        {
          "english": "<style=\"Body\">You step away from the altar. The focus crystals dim to a dull embers, and the brass gears grind to a quiet halt."
        },
        {
          "english": "<whisper>\"A covenant carved in fire,\"</whisper> the voice hums, fading into the chamber. <whisper>\"Speak the words, and let the heavens answer.\"</whisper></style>"
        },
        {
          "english": "<style=\"Body\">The two units step onto the altar. Rings of oxidized metal grind into motion, aligning focus lenses overhead until a single lance of auric light pierces the chamber."
        },
        {
          "english": "<style=\"Body\">Beyond the celestial archway lies a shattered ivory and brass chamber. At its center, an ancient Divine Altar <bigshake>roars</bigshake> to life, its focus crystals flaring with residual temple light."
        },
        {
          "english": "A <mystical>mysterious whisper</mystical> echoes from within the chamber:"
        }
      ],
